# ── Shopify ──────────────────────────────────────────────────────────────────
# Server-side. With these two set, the live store becomes the source of the
# product title, prices and photography (images served from cdn.shopify.com).
# SHOPIFY_ADMIN_TOKEN is a SECRET — never prefix it with NEXT_PUBLIC_.
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_ADMIN_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Which product to feature. Prefer the handle (exact); otherwise the first
# match for SHOPIFY_PRODUCT_QUERY wins.
SHOPIFY_PRODUCT_HANDLE=
SHOPIFY_PRODUCT_QUERY=status:active

# Public. Same domain — needed in the browser to build the checkout permalink.
NEXT_PUBLIC_SHOPIFY_DOMAIN=your-store.myshopify.com

# Optional. A Storefront API token upgrades checkout from a cart permalink to a
# real Shopify cart via /api/checkout. Not required.
SHOPIFY_STOREFRONT_TOKEN=

# Optional. Defaults to 2025-01.
SHOPIFY_API_VERSION=2025-01

# ── Site ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://lumera.com

# ── Reviews ──────────────────────────────────────────────────────────────────
# Renders clearly-labelled SAMPLE review cards so you can see the layout.
# MUST be false (or removed) in production until real reviews exist.
NEXT_PUBLIC_SHOW_PLACEHOLDER_REVIEWS=false
