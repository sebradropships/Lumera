# ── Shopify ──────────────────────────────────────────────────────────────────
# Your store domain. Enables cart-permalink checkout on its own.
NEXT_PUBLIC_SHOPIFY_DOMAIN=your-store.myshopify.com

# Storefront API token — enables real Shopify carts via /api/checkout.
# Shopify admin → Settings → Apps and sales channels → Develop apps →
# create an app → Storefront API → enable unauthenticated_write_checkouts.
SHOPIFY_STOREFRONT_TOKEN=

# Optional. Defaults to 2025-01.
SHOPIFY_API_VERSION=2025-01

# ── Site ─────────────────────────────────────────────────────────────────────
# Canonical URL used for metadata / Open Graph.
NEXT_PUBLIC_SITE_URL=https://lumera.com

# ── Reviews ──────────────────────────────────────────────────────────────────
# Renders clearly-labelled SAMPLE review cards so you can see the layout.
# MUST be false (or removed) in production until real reviews exist.
NEXT_PUBLIC_SHOW_PLACEHOLDER_REVIEWS=false
